# ── Telegram ──────────────────────────────
# Get from @BotFather. Required.
BOT_TOKEN=
# Comma separated Telegram user IDs allowed to use the bot (the first is the owner).
OWNER_IDS=
# Comma separated extra admin IDs (optional)
ADMIN_IDS=

# ── Storage ───────────────────────────────
DATA_DIR=./data

# ── Media ─────────────────────────────────
# FFmpeg binary used for video processing. Leave empty to auto-detect:
# ffmpeg-static (optional dep) -> vendor/ffmpeg -> PATH.
FFMPEG_PATH=

# ── AI (optional) ─────────────────────────
# Provider: builtin | ollama | openai-compatible
AI_PROVIDER=builtin
# For ollama / openai-compatible providers:
AI_ENDPOINT=http://127.0.0.1:11434
AI_MODEL=
# AI_API_KEY=

# ── Pinterest ─────────────────────────────
# Provider: web (public search pages) | fixture (demo/tests)
PINTEREST_PROVIDER=web

# ── BrowserOS Neo (Independent Browser Service) ───
BROWSEROS_ENABLED=true
BROWSEROS_MCP_URL=http://127.0.0.1:9010/mcp
BROWSEROS_BASE_URL=http://127.0.0.1:9010
BROWSEROS_NOVNC_URL=http://127.0.0.1:6080
BROWSEROS_CONNECTOR_MODE=local
# BROWSEROS_API_TOKEN=
BROWSEROS_STREAM_QUALITY=high
BROWSEROS_STREAM_FPS=12
BROWSEROS_STREAM_WIDTH=1280
BROWSEROS_STREAM_HEIGHT=720
